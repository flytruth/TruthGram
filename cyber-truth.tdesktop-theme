//
// TruthGram "Cyber-Truth" theme
// Deep Obsidian Black + Electric Lime Green + Ice Light Blue
//
// This is a standard .tdesktop-theme file: a line-oriented INI-like format
// consumed by tdesktop's ThemeParser. It is 100% hot-swappable — dropping
// any other .tdesktop-theme into Settings > TruthGram Appearance replaces it.
//

[Variables]
// ---- Base palette ----
windowBg:                       #0a0c0e
windowBgOver:                   #111418
windowBgRipple:                 #161a1f
windowFg:                       #e6edf3
windowFgOver:                   #f0f6fc
windowSubTextFg:                #7d8590
windowActiveFg:                 #39ff14
windowBgActive:                 #111418

// ---- Accent / active elements (Electric Lime) ----
activeButtonBg:                 #39ff14
activeButtonBgOver:             #84cc16
activeButtonBgRipple:           #65a30d
activeButtonFg:                 #0a0c0e
activeButtonFgOver:             #0a0c0e
activeLineFg:                   #39ff14
activeTextFg:                   #39ff14

// ---- Secondary accent / links / highlights (Ice Light Blue) ----
lightButtonBg:                  #111418
lightButtonBgOver:              #161a1f
lightButtonBgRipple:            #1c2128
lightButtonFg:                  #38bdf8
lightButtonFgOver:              #7dd3fc
windowBgActiveText:             #38bdf8
// legacy alias used by some tdesktop widgets
activeLinkFg:                   #38bdf8
lightBgLinks:                   #7dd3fc

// ---- History / chat bubbles ----
historyBg:                      #0a0c0e
historyScrollBg:                #111418
historyScrollBgOver:            #161a1f
historyScrollBgRipple:          #1c2128
msgInBg:                        #161a1f
msgInBgSelected:                #1c2230
msgOutBg:                       #0f1216
msgOutBgSelected:               #141a22
msgInShadow:                    #00000000
msgInDateFg:                    #7dd3fc
msgOutDateFg:                   #84cc16
msgServiceFg:                   #e6edf3
msgServiceBg:                   #161a1fa0
msgShadow:                      #00000000

// Text colors inside bubbles
msgInMonoFg:                    #c9d1d9
msgOutMonoFg:                   #e6edf3
historyTextInFg:                #e6edf3
historyTextOutFg:               #f0f6fc
historyAttachmentInFg:          #38bdf8
historyAttachmentOutFg:         #39ff14
historyTextInLinkFg:            #38bdf8
historyTextOutLinkFg:           #7dd3fc
historyTextSelectedFg:          #f0f6fc
historyReplyFg:                 #38bdf8
historyReplyOutFg:              #39ff14
historyReplyNameFg:             #7dd3fc

// ---- Input area ----
botKbBg:                        #0f1216
botKbButtonFg:                  #e6edf3
historyComposeAreaBg:           #111418
historyComposeAreaFg:           #e6edf3
historyComposeAreaFgSelected:   #39ff14
historyComposeIconFg:           #7d8590
historyComposeIconFgOver:       #38bdf8
historySendIconFg:              #39ff14
historySendIconFgOver:          #84cc16
historyPinnedBg:                #0a0c0e

// ---- Sidebar / dialogs list ----
dialogsBg:                      #0a0c0e
dialogsBgOver:                  #111418
dialogsBgRipple:                #161a1f
dialogsTextFg:                  #e6edf3
dialogsTextFgOver:              #f0f6fc
dialogsNameFg:                  #e6edf3
dialogsNameFgOver:              #39ff14
dialogsDateFg:                  #7d8590
dialogsUnreadFg:                #0a0c0e
dialogsUnreadBg:                #39ff14
dialogsUnreadBgMuted:           #38bdf8
dialogsUnreadFgMuted:           #0a0c0e
dialogsSendingIconFg:           #84cc16
dialogsSentIconFg:              #39ff14
dialogsVerifiedIconBg:          #38bdf8
dialogsVerifiedIconFg:          #0a0c0e
dialogsForwardFg:               #39ff14

// ---- Top bar / section ----
topBarBg:                        #0a0c0e
topBarBgOver:                    #111418
topBarFg:                        #e6edf3
topBarFgActive:                  #39ff14
topBarBgRipple:                  #161a1f

// ---- Menu ----
menuBg:                          #111418
menuBgOver:                      #161a1f
menuBgRipple:                    #1c2128
menuFg:                          #e6edf3
menuFgDisabled:                  #7d8590
menuIconFg:                      #7d8590
menuIconFgOver:                  #38bdf8

// ---- Settings ----
boxBg:                           #0a0c0e
boxBgOver:                       #111418
boxBgRipple:                     #161a1f
boxTextFg:                       #e6edf3
boxTextFgGood:                   #39ff14
boxTextFgError:                  #ff4d4d
boxTitleFg:                      #39ff14
boxTitleCloseFg:                 #7d8590
boxSearchBg:                     #111418
boxSearchFg:                     #e6edf3

// ---- TruthGram-specific extras (parsed by TruthGram theme engine) ----
// TruthGram reserves keys with the "tg_" prefix; upstream ignores them.
tg_accent_lime:                  #39ff14
tg_accent_lime_dim:              #84cc16
tg_accent_ice:                   #38bdf8
tg_accent_ice_dim:               #7dd3fc
tg_bg_obsidian:                  #0a0c0e
tg_bg_obsidian_alt:              #111418
tg_frost_blur_radius:            24
tg_bubble_radius:                14
tg_spring_damping:               0.825
tg_spring_stiffness:             0.45
tg_miniplayer_fft_low:           #39ff14
tg_miniplayer_fft_high:          #38bdf8
tg_ghost_bar_bg:                 #161a1f
tg_ghost_bar_border:             #1c2128
tg_osint_meta_bg:                #0f1216
tg_osint_meta_border:            #1c2128

[Fonts]
// Fall back to system fonts; TruthGram prefers Noto Sans / SF Pro.
uiFont:      "Noto Sans, -apple-system, SF Pro Text, 13px"
semiboldFont:"Noto Sans, -apple-system, SF Pro Text Semibold, 13px"
boldFont:    "Noto Sans, -apple-system, SF Pro Text Bold, 13px"
monoFont:    "JetBrains Mono, SF Mono, Menlo, Consolas, 12px"
