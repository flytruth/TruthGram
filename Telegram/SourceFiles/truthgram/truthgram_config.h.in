// truthgram_config.h.in
//
// Rendered by CMake configure_file() (at-sign-only substitution mode) into
//   the generated/ build directory as truthgram_config.h
// during CMake configure. Do NOT include the .in directly; the build adds
// the generated/ directory to the include path so a bare
//   #include "truthgram_config.h"
// resolves to the generated copy.
//
// Every TRUTHGRAM_ENABLE_* flag is substituted from the matching CMake option
// (normalized to 1 / 0 in CMakeLists.txt). The `#if !defined(...)` guard means
// the define is only emitted when the compiler command line has not already
// supplied it via -D, so this header stays correct whether or not
// target_compile_definitions also passes the flag.
//
// TruthGram - privacy-first, zero-telemetry Telegram Desktop client
// Copyright (C) 2026 TruthGram Contributors
#pragma once

#include "truthgram_version.h"   // generated

namespace tg::truthgram {

