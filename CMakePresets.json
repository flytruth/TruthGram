{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-msvc-ninja",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER":   "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE":   "Release",
                "TRUTHGRAM_ENABLE_LTO": "ON"
            },
            "condition": { "equals": { "lhs": "${hostSystemName}", "rhs": "Windows" } }
        },
        {
            "name": "linux-gcc-ninja",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER":   "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE":   "Release",
                "TRUTHGRAM_ENABLE_LTO": "ON"
            },
            "condition": { "equals": { "lhs": "${hostSystemName}", "rhs": "Linux" } }
        },
        {
            "name": "linux-clang-ninja",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER":   "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE":   "Release"
            },
            "condition": { "equals": { "lhs": "${hostSystemName}", "rhs": "Linux" } }
        },
        {
            "name": "macos-arm64-clang",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER":   "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE":   "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            },
            "condition": { "equals": { "lhs": "${hostSystemName}", "rhs": "Darwin" } }
        },
        {
            "name": "macos-x86_64-clang",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER":   "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE":   "Release",
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            },
            "condition": { "equals": { "lhs": "${hostSystemName}", "rhs": "Darwin" } }
        },
        {
            "name": "debug-asan",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":        "Debug",
                "TRUTHGRAM_ENABLE_ASAN":   "ON",
                "TRUTHGRAM_ENABLE_LTO":    "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-msvc-ninja",  "configurePreset": "windows-msvc-ninja",  "targets": ["truthgram_app"] },
        { "name": "linux-gcc-ninja",     "configurePreset": "linux-gcc-ninja",     "targets": ["truthgram_app"] },
        { "name": "linux-clang-ninja",   "configurePreset": "linux-clang-ninja",   "targets": ["truthgram_app"] },
        { "name": "macos-arm64-clang",   "configurePreset": "macos-arm64-clang",   "targets": ["truthgram_app"] },
        { "name": "macos-x86_64-clang",  "configurePreset": "macos-x86_64-clang",  "targets": ["truthgram_app"] },
        { "name": "debug-asan",          "configurePreset": "debug-asan",          "targets": ["truthgram_app"] }
    ]
}
