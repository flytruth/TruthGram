diff --git a/download/TruthGram/cmake/FindFFMPEG.cmake b/download/TruthGram/cmake/FindFFMPEG.cmake
new file mode 100644
index 0000000..75cb6c2
--- /dev/null
+++ b/download/TruthGram/cmake/FindFFMPEG.cmake
@@ -0,0 +1,146 @@
+# =============================================================================
+# FindFFMPEG.cmake - locate FFmpeg libav* and expose FFmpeg::<lib> targets.
+# =============================================================================
+# Works on Arch Linux (ffmpeg core package) and Debian/Ubuntu (libavcodec-dev
+# etc.) by trying pkg-config first, then falling back to find_path/find_library.
+# Each component (avcodec, avformat, avutil, ...) becomes an imported target
+# named FFmpeg::<component> with include dirs and link flags attached.
+#
+# Usage:
+#   find_package(FFMPEG [REQUIRED] [COMPONENTS avcodec avformat avutil ...])
+#
+# This file is safe to include more than once: every add_library() is guarded
+# by `if(NOT TARGET FFmpeg::FFMPEG)`.
+
+find_package(PkgConfig QUIET)
+
+# The set of FFmpeg libraries we know how to find. The caller passes a subset
+# via COMPONENTS; we intersect with this list.
+set(_FFMPEG_KNOWN_COMPONENTS
+    avcodec avdevice avfilter avformat avutil swresample swscale postproc)
+
+if(FFMPEG_FIND_COMPONENTS)
+    set(_FFMPEG_REQUESTED ${FFMPEG_FIND_COMPONENTS})
+else()
+    set(_FFMPEG_REQUESTED ${_FFMPEG_KNOWN_COMPONENTS})
+endif()
+
+# Resolve every requested component via pkg-config, then fall back to a plain
+# find_path/find_library pair. We accumulate the include dirs and libraries
+# into FFMPEG_INCLUDE_DIRS / FFMPEG_LIBRARIES for the legacy variables, and
+# also build one imported target per component plus an umbrella FFmpeg::FFMPEG.
+set(FFMPEG_INCLUDE_DIRS "")
+set(FFMPEG_LIBRARIES "")
+set(_FFMPEG_ALL_FOUND TRUE)
+
+foreach(_comp IN LISTS _FFMPEG_REQUESTED)
+    # pkg-config module name is "lib<comp>" (e.g. libavcodec).
+    set(_pc_module "lib${_comp}")
+    if(PkgConfig_FOUND)
+        pkg_check_modules(PC_${_comp} QUIET ${_pc_module})
+    endif()
+
+    if(PC_${_comp}_FOUND)
+        set(_inc_dirs "${PC_${_comp}_INCLUDE_DIRS}")
+        set(_lib_dirs "${PC_${_comp}_LIBRARY_DIRS}")
+        set(_libs      "${PC_${_comp}_LIBRARIES}")
+        set(_version   "${PC_${_comp}_VERSION}")
+        # find_path/find_library over the pkg-config hints so we get an
+        # absolute file path for IMPORTED_LOCATION.
+        find_path(${_comp}_INCLUDE_DIR
+            NAMES lib${_comp}/avcodec.h
+                  lib${_comp}/avformat.h
+                  lib${_comp}/avutil.h
+                  lib${_comp}/swresample.h
+                  lib${_comp}/swscale.h
+            HINTS ${_inc_dirs}
+            PATH_SUFFIXES include
+            DOC "Path to lib${_comp} headers"
+        )
+    else()
+        find_path(${_comp}_INCLUDE_DIR
+            NAMES lib${_comp}/avcodec.h
+                  lib${_comp}/avformat.h
+                  lib${_comp}/avutil.h
+                  lib${_comp}/swresample.h
+                  lib${_comp}/swscale.h
+            PATH_SUFFIXES include
+            DOC "Path to lib${_comp} headers"
+        )
+        find_library(${_comp}_LIBRARY
+            NAMES ${_comp}
+            PATH_SUFFIXES lib lib64
+            DOC "Path to lib${_comp}"
+        )
+        set(_libs "${_comp}")
+        set(_version "")
+    endif()
+
+    # The library file itself: prefer the find_library result, else use the
+    # first pkg-config library entry resolved against the lib dirs.
+    if(NOT ${_comp}_LIBRARY AND PC_${_comp}_FOUND)
+        foreach(_l IN LISTS PC_${_comp}_LIBRARIES)
+            find_library(_resolved_${_comp} NAMES ${_l} HINTS ${PC_${_comp}_LIBRARY_DIRS})
+            if(_resolved_${_comp})
+                set(${_comp}_LIBRARY "${_resolved_${_comp}}")
+                break()
+            endif()
+        endforeach()
+    endif()
+
+    if(${_comp}_INCLUDE_DIR AND ${_comp}_LIBRARY)
+        set(FFMPEG_${_comp}_FOUND TRUE)
+        if(FFMPEG_INCLUDE_DIRS)
+            string(APPEND FFMPEG_INCLUDE_DIRS " ${${_comp}_INCLUDE_DIR}")
+        else()
+            set(FFMPEG_INCLUDE_DIRS "${${_comp}_INCLUDE_DIR}")
+        endif()
+        if(FFMPEG_LIBRARIES)
+            string(APPEND FFMPEG_LIBRARIES " ${${_comp}_LIBRARY}")
+        else()
+            set(FFMPEG_LIBRARIES "${${_comp}_LIBRARY}")
+        endif()
+
+        if(NOT TARGET FFmpeg::${_comp})
+            add_library(FFmpeg::${_comp} UNKNOWN IMPORTED)
+            set_target_properties(FFmpeg::${_comp} PROPERTIES
+                IMPORTED_LOCATION "${${_comp}_LIBRARY}"
+                INTERFACE_INCLUDE_DIRECTORIES "${${_comp}_INCLUDE_DIR}")
+        endif()
+        if(_version)
+            set_target_properties(FFmpeg::${_comp} PROPERTIES
+                INTERFACE_VERSION "${_version}")
+        endif()
+    else()
+        # Component not found. We only set FFMPEG_<comp>_FOUND=FALSE here and
+        # let find_package_handle_standard_args(HANDLE_COMPONENTS) decide
+        # whether that is fatal: it FATAL_ERRORs only when the caller passed
+        # REQUIRED (or required this specific component). A plain
+        # find_package(FFMPEG COMPONENTS ...) with no deps installed must
+        # simply report FFMPEG_FOUND=FALSE and continue.
+        set(FFMPEG_${_comp}_FOUND FALSE)
+        set(_FFMPEG_ALL_FOUND FALSE)
+    endif()
+endforeach()
+
+# Umbrella target linking every found component.
+if(_FFMPEG_ALL_FOUND AND FFMPEG_LIBRARIES AND NOT TARGET FFmpeg::FFMPEG)
+    add_library(FFmpeg::FFMPEG INTERFACE IMPORTED)
+    set(_deps "")
+    foreach(_comp IN LISTS _FFMPEG_REQUESTED)
+        if(TARGET FFmpeg::${_comp})
+            list(APPEND _deps FFmpeg::${_comp})
+        endif()
+    endforeach()
+    set_target_properties(FFmpeg::FFMPEG PROPERTIES
+        INTERFACE_LINK_LIBRARIES "${_deps}")
+endif()
+
+include(FindPackageHandleStandardArgs)
+# Handle REQUIRED / QUIET / version. We only validate the per-component
+# results so the standard args macro reports a clean reason on failure.
+find_package_handle_standard_args(FFMPEG
+    REQUIRED_VARS FFMPEG_LIBRARIES FFMPEG_INCLUDE_DIRS
+    HANDLE_COMPONENTS)
+
+mark_as_advanced(FFMPEG_INCLUDE_DIRS FFMPEG_LIBRARIES)
diff --git a/download/TruthGram/cmake/FindKissFFT.cmake b/download/TruthGram/cmake/FindKissFFT.cmake
new file mode 100644
index 0000000..5dab91b
--- /dev/null
+++ b/download/TruthGram/cmake/FindKissFFT.cmake
@@ -0,0 +1,65 @@
+# =============================================================================
+# FindKissFFT.cmake - optionally locate Kiss FFT for the Mini Player FFT bars.
+# =============================================================================
+# Optional dependency. When found, sets TRUTHGRAM_HAVE_KISSFFT=1 (consumed by
+# mini_player.h/.cpp to use the real kiss_fftr API). When not found, the Mini
+# Player still builds and runs — the waveform bars simply render zero-height
+# (the player controls, speed slider, pitch lock all work regardless).
+#
+# Kiss FFT ships several flavours (float / double / int / fast). We prefer the
+# float flavour since the Mini Player feeds float samples. pkg-config module
+# names vary by distro (Arch: kissfft-float; Debian: kissfft-float), so we try
+# a list and fall back to find_path/find_library.
+
+find_package(PkgConfig QUIET)
+
+set(_KISSFFT_PC_MODULES kissfft-float kissfft_float kissfft)
+set(_KISSFFT_PC_FOUND FALSE)
+foreach(_pc IN LISTS _KISSFFT_PC_MODULES)
+    if(PkgConfig_FOUND)
+        pkg_check_modules(PC_KISSFFT QUIET ${_pc})
+    endif()
+    if(PC_KISSFFT_FOUND)
+        set(_KISSFFT_PC_FOUND TRUE)
+        break()
+    endif()
+endforeach()
+
+if(_KISSFFT_PC_FOUND)
+    find_path(KissFFT_INCLUDE_DIR
+        NAMES kiss_fft.h kiss_fftr.h
+        HINTS ${PC_KISSFFT_INCLUDE_DIRS}
+        PATH_SUFFIXES include
+        DOC "Path to Kiss FFT headers"
+    )
+    find_library(KissFFT_LIBRARY
+        NAMES ${PC_KISSFFT_LIBRARIES} kissfft_float kissfft-float kissfft
+        HINTS ${PC_KISSFFT_LIBRARY_DIRS}
+        PATH_SUFFIXES lib lib64
+        DOC "Path to libkissfft"
+    )
+else()
+    find_path(KissFFT_INCLUDE_DIR
+        NAMES kiss_fft.h kiss_fftr.h
+        PATH_SUFFIXES include kissfft
+        DOC "Path to Kiss FFT headers"
+    )
+    find_library(KissFFT_LIBRARY
+        NAMES kissfft_float kissfft-float kissfft
+        PATH_SUFFIXES lib lib64
+        DOC "Path to libkissfft"
+    )
+endif()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(KissFFT
+    REQUIRED_VARS KissFFT_LIBRARY KissFFT_INCLUDE_DIR)
+
+if(KissFFT_FOUND AND NOT TARGET KissFFT::KissFFT)
+    add_library(KissFFT::KissFFT UNKNOWN IMPORTED)
+    set_target_properties(KissFFT::KissFFT PROPERTIES
+        IMPORTED_LOCATION "${KissFFT_LIBRARY}"
+        INTERFACE_INCLUDE_DIRECTORIES "${KissFFT_INCLUDE_DIR}")
+endif()
+
+mark_as_advanced(KissFFT_INCLUDE_DIR KissFFT_LIBRARY)
diff --git a/download/TruthGram/cmake/FindLuaJIT.cmake b/download/TruthGram/cmake/FindLuaJIT.cmake
new file mode 100644
index 0000000..ec82f68
--- /dev/null
+++ b/download/TruthGram/cmake/FindLuaJIT.cmake
@@ -0,0 +1,87 @@
+# =============================================================================
+# FindLuaJIT.cmake - locate LuaJIT and expose the LuaJIT::LuaJIT target.
+# =============================================================================
+# Works on Arch Linux (luajit package, headers under /usr/include/luajit-2.1)
+# and Debian/Ubuntu (libluajit-5.1-dev, headers under /usr/include/luajit-2.1).
+#
+# Strategy:
+#   1. pkg-config (module "luajit" on Arch, "luajit" / "luajit-5.1" elsewhere)
+#      -> gives the exact include dir + library + version.
+#   2. Fall back to find_path (with the luajit-2.1 / luajit suffix so that
+#      `#include <lua.h>` resolves to the LuaJIT copy, not plain Lua) and
+#      find_library for the .so/.a.
+#
+# The imported target LuaJIT::LuaJIT is created exactly once — the
+# `if(NOT TARGET LuaJIT::LuaJIT)` guard means re-running find_package (e.g.
+# when TruthGram is embedded in a larger build) never raises a duplicate
+# target error.
+
+find_package(PkgConfig QUIET)
+
+# Try the known pkg-config module names in order.
+set(_LUAJIT_PC_MODULES luajit luajit-5.1 lua51)
+set(_LUAJIT_PC_FOUND FALSE)
+foreach(_pc IN LISTS _LUAJIT_PC_MODULES)
+    if(PkgConfig_FOUND)
+        pkg_check_modules(PC_LUAJIT QUIET ${_pc})
+    endif()
+    if(PC_LUAJIT_FOUND)
+        set(_LUAJIT_PC_FOUND TRUE)
+        set(_LUAJIT_PC_MODULE "${_pc}")
+        break()
+    endif()
+endforeach()
+
+if(_LUAJIT_PC_FOUND)
+    set(LUAJIT_VERSION "${PC_LUAJIT_VERSION}")
+    # find_path/find_library over the pkg-config hints so we get absolute
+    # paths for the imported target (pkg-config alone gives compiler flags).
+    find_path(LUAJIT_INCLUDE_DIR
+        NAMES lua.h lualib.h lauxlib.h
+        HINTS ${PC_LUAJIT_INCLUDE_DIRS}
+        PATH_SUFFIXES luajit-2.1 luajit
+        DOC "Path to LuaJIT headers (directory containing lua.h)"
+    )
+    # Resolve the actual library file (PC_LUAJIT_LIBRARIES is a name list).
+    find_library(LUAJIT_LIBRARY
+        NAMES ${PC_LUAJIT_LIBRARIES} luajit luajit-5.1
+        HINTS ${PC_LUAJIT_LIBRARY_DIRS}
+        PATH_SUFFIXES lib lib64
+        DOC "Path to libluajit"
+    )
+else()
+    # No pkg-config — fall back to a plain find. The PATH_SUFFIXES are what
+    # make `#include <lua.h>` find the LuaJIT copy on Arch/Debian, where the
+    # headers live in /usr/include/luajit-2.1/ rather than /usr/include/.
+    find_path(LUAJIT_INCLUDE_DIR
+        NAMES lua.h lualib.h lauxlib.h
+        PATH_SUFFIXES luajit-2.1 luajit include/luajit-2.1 include/luajit
+        DOC "Path to LuaJIT headers (directory containing lua.h)"
+    )
+    find_library(LUAJIT_LIBRARY
+        NAMES luajit luajit-5.1
+        PATH_SUFFIXES lib lib64
+        DOC "Path to libluajit"
+    )
+endif()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(LuaJIT
+    REQUIRED_VARS LUAJIT_LIBRARY LUAJIT_INCLUDE_DIR
+    VERSION_VAR LUAJIT_VERSION)
+
+# Create the imported target exactly once. Downstream code does
+#   target_link_libraries(my_target PRIVATE LuaJIT::LuaJIT)
+# and gets both the include dir (so `#include <lua.h>` resolves to LuaJIT) and
+# the link flag.
+if(LUAJIT_FOUND AND NOT TARGET LuaJIT::LuaJIT)
+    add_library(LuaJIT::LuaJIT UNKNOWN IMPORTED)
+    set_target_properties(LuaJIT::LuaJIT PROPERTIES
+        IMPORTED_LOCATION "${LUAJIT_LIBRARY}"
+        INTERFACE_INCLUDE_DIRECTORIES "${LUAJIT_INCLUDE_DIR}"
+        INTERFACE_LINK_LIBRARIES "m;dl"
+        # LuaJIT needs -lm and -ldl on Linux. These are no-ops on Windows.
+    )
+endif()
+
+mark_as_advanced(LUAJIT_INCLUDE_DIR LUAJIT_LIBRARY)
