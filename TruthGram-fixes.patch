-    NAMES sqlcipher/sqlite3.h sqlite3.h
-    PATH_SUFFIXES include sqlcipher
-)
-find_library(SQLCipher_LIBRARY
-    NAMES sqlcipher sqlite3
-    PATH_SUFFIXES lib lib64
-)
+find_package(PkgConfig QUIET)
+
+if(PkgConfig_FOUND)
